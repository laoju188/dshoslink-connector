{
  "name": "@dshos-link/connector",
  "version": "0.2.15",
  "description": "DSHOS Link connector for the official DeepSeek Harness on Windows.",
  "type": "module",
  "bin": {
    "dshos-link-connector": "./scripts/npm-cli.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./typert": {
      "types": "./dist/typert.d.ts",
      "default": "./dist/typert.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "docs/windows-installation.md",
    "docs/pairing-diagnostics.md",
    "docs/one-click-upgrade.md",
    "docs/dsh-desktop-compatibility.md",
    "LICENSE",
    "scripts/npm-cli.mjs",
    "scripts/diagnose.mjs",
    "scripts/windows/Manage-DshosLinkConnector.ps1",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "scripts/windows/Manage-DshosLinkBalance.ps1",
    "scripts/windows/Manage-DshosLinkDesktop.ps1",
    "scripts/windows/Inspect-DshosBalance.mjs",
    "docs/building-windows-package.md"
  ],
  "os": [
    "win32"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-image-prepare.mjs && node scripts/build-updater.mjs",
    "test": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-image-prepare.mjs && node scripts/build-updater.mjs && tsc -p tsconfig.test.json && node --test .test/tests/*.test.js tests/connector-upgrade.test.mjs tests/license-notices.test.mjs tests/link-diagnostic-reporter.test.mjs tests/npm-cli.test.mjs ../patches/dsh-deepseek-balance/balance-api.test.mjs tests/pause-network-resume.test.mjs tests/installer-version.test.mjs",
    "prepack": "node scripts/write-third-party-notices.mjs --check && node scripts/verify-balance-payload.mjs && node scripts/verify-build-output.mjs",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Build-WindowsRelease.ps1",
    "test:balance-manager": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/windows-balance-manager.test.ps1",
    "test:updater-migration": "node --test tests/connector-upgrade-migration.test.mjs",
    "test:provider-rc2": "node --test ../patches/dsh-deepseek-balance/provider-rc2-integration.test.mjs"
  },
  "dependencies": {
    "sharp": "0.35.4",
    "@homebridge/ciao": "1.3.12",
    "@peculiar/x509": "2.0.0",
    "reflect-metadata": "0.2.2",
    "zod": "^4.4.3",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment-local": "0.1.5-rc.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "^6.0.3"
  },
  "dshosBundledLibraries": [
    "@deepseek-ai/dsh-attachment-local"
  ],
  "license": "MIT",
  "dshosUpgrade": {
    "protocol": 1,
    "hosts": [
      "0.1.1-rc.2",
      "0.1.5-rc.1",
      "0.1.6-alpha.1",
      "0.1.7-alpha.2",
      "0.1.7-rc.2",
      "0.2.0-rc.1",
      "0.2.0-rc.2",
      "0.2.1-rc.2",
      "0.2.1-rc.3",
      "0.2.1-rc.5",
      "0.2.2-rc.1",
      "0.2.2-rc.2"
    ]
  },
  "private": true
}
